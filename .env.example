# Copy this file to .env.local. Every value below is public — this app has no
# secrets, no backend and never touches a private key.

# Chain to talk to. "injective-888" is testnet, "injective-1" is mainnet.
NEXT_PUBLIC_CHAIN_ID=injective-888

# Injective testnet LCD (REST) endpoint. Used to read the account's
# number/sequence, read the INJ balance and broadcast the signed transaction.
NEXT_PUBLIC_REST_ENDPOINT=https://testnet.sentry.lcd.injective.network

# Block explorer used to build the link shown after a successful transfer.
NEXT_PUBLIC_EXPLORER_URL=https://testnet.explorer.injective.network
